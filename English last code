from pybricks.hubs import * # Import the hub library
from pybricks.pupdevices import * # Import the peripheral devices library
from pybricks.parameters import * # Import the parameter constants
from pybricks.tools import * # Import the general tools library
 
hub = PrimeHub() # Names the hub as hub
left_motor = Motor(Port.B) # The motor in port B is named left_motor and rotates clockwise
right_motor = Motor(Port.F, Direction.COUNTERCLOCKWISE) # The motor in port F is named right_motor and rotates counterclockwise
attachment_left = Motor(Port.E) # The attachment motor in port E is named attachment_left and the gear ratio is 12, 12, 20
attachment_right = Motor(Port.A)  # The attachment motor in port A is named attachment_right and the gear ratio is 12, 12, 20
attachment_left.control.limits(1000, 6500) # Set speed and acceleration limits for the left attachment motor
attachment_right.control.limits(1000, 6500) # Set speed and acceleration limits for the right attachment motor
left_motor.control.limits(2000, 5500) # Set speed and acceleration limits for the left drive motor
right_motor.control.limits(2000, 5500) # Set speed and acceleration limits for the right drive motor
while not hub.imu.ready(): hub.display.char("x") # Wait until the gyro is ready and display an x
 
hub.imu.reset_heading(0) # Sets the gyro value to 0
heading = 0 # Creates a variable named heading with a value of 0
right_gear_ratio = 1 # Creates a variable named right_gear_ratio with a value of 1, this will count the gear ratios
left_gear_ratio = 1 # Creates a variable named left_gear_ratio with a value of 1, this will count the gear ratios
 
def drive_straight(distance, min_speed=40, acceleration=40, correction=0.01, max_speed = 700, deceleration=80, timeout = None): # Creates a function named drive_straight with parameters for distance and movement control
    if timeout != None: # Check if a timeout limit is provided
        timeout_watch = StopWatch() # Create a stopwatch object for the timeout
        timeout_watch.resume() # Start the stopwatch
    global heading # Allows the function to use the heading variable inside the function
    left_motor.reset_angle(0) # Sets the left angle to 0
    right_motor.reset_angle(0) # Sets the right angle to 0
    distance = distance / 0.489 # Converts distance given in mm to motor degrees, dividing wheel circumference by 360
    acceleration /= 0.489 # Converts acceleration given in mm to motor degrees, dividing wheel circumference by 360
    deceleration /= 0.489 # Converts deceleration given in mm to motor degrees, dividing wheel circumference by 360
    while True: # Starts a loop that runs until stopped
        if timeout != None and timeout_watch.time() >= timeout: break # Exit the loop if the time limit is reached           
        distance_done = (left_motor.angle()+right_motor.angle()) / 2 # Adds left and right angles and divides by 2, resulting in the average distance covered
        distance_left = distance - distance_done # Subtracts distance_done from distance to get distance_left
        multiplier = distance_left/abs(distance_left) # Divides distance_left by its absolute value to get the direction (1 or -1)
        distance_done = abs(distance_done) # The absolute value of distance_done should be distance_done
        distance_left = abs(distance_left) # The absolute value of distance_left should be distance_left
        if distance_left < 3: # If distance_left is less than 3 motor degrees
            break # Then stop, i.e., exit the while loop
        if distance_left < deceleration : # If distance_left is less than deceleration (if already in the deceleration phase)
            ratio = distance_left / deceleration # Then the deceleration ratio is distance_left/deceleration (0-1)
            current_speed = max(ratio * max_speed, min_speed) * multiplier # Calculate speed for deceleration multiplied by the direction
        elif distance_done < acceleration: # If not the previous, and distance_done is less than acceleration
            ratio = distance_done / acceleration # The ratio equals distance_done / acceleration (0-1)
            current_speed = max(ratio * max_speed, min_speed) * multiplier # Calculate speed for acceleration multiplied by the direction
        else: # If none of the above (constant speed phase)
            current_speed = max_speed * multiplier # Current_speed equals max_speed multiplied by the direction
        heading_error = (heading - hub.imu.heading()) * correction # Calculate heading error multiplied by the correction factor
        correction_amount = current_speed * heading_error * multiplier # Calculate the amount to correct by based on speed and error
        left_motor.run (current_speed - correction_amount) # Apply speed to left motor with correction
        right_motor.run(current_speed + correction_amount) # Apply speed to right motor with correction
    left_motor.hold() # Left stops (holds its position right there)
    right_motor.hold()# Right stops (holds its position right there)
 
def turn(target_angle, max_speed=360, deceleration=80, min_speed=50, timeout = None): # Creates a function named turn with parameters for angle and speed control
    if timeout != None: # Check if a timeout limit is provided
        timeout_watch = StopWatch() # Create a stopwatch object for the timeout
        timeout_watch.resume() # Start the stopwatch
    base_angle = hub.imu.heading() # Base_angle equals the gyro value, needed to correct based on previous errors
    global heading # Allows the function to use the heading variable inside the function
    target_heading = heading + target_angle # Target_heading equals heading plus the requested turn angle
    heading = target_heading # Heading equals target_heading
    target_heading -= base_angle # Subtract base_angle from target_heading to handle relative turn
    while True: # Loop runs until exit
        if timeout != None and timeout_watch.time() >= timeout: break # Exit the loop if the time limit is reached
        angle_done = hub.imu.heading() - base_angle # Angle_done equals current gyro minus the base angle
        angle_left = target_heading - angle_done # Angle_left equals target_heading minus angle_done
        multiplier = angle_left/abs(angle_left) # Determine turn direction (1 or -1)
        angle_left = abs(angle_left) # The absolute value of angle_left should be angle_left
        if angle_left <= 0.5: # If angle_left is less than or equal to 0.5
            break # Then stop, i.e., exit the while loop      
        if angle_left < deceleration : # If angle_left is less than deceleration (deceleration phase)
            ratio = angle_left / deceleration # Then the deceleration ratio is angle_left/deceleration
            current_speed = max(ratio * max_speed, min_speed) * multiplier # Calculate current turning speed
        else: # If not the previous, i.e., not decelerating
            current_speed = max_speed * multiplier # Then current_speed equals max_speed multiplied by direction
        left_motor.run(-current_speed) # Spin left motor in the calculated direction
        right_motor.run(current_speed) # Spin right motor in the opposite direction
    left_motor.hold() # Left stops (holds its position)
    right_motor.hold() # Right stops (holds its position)
    wait(100) # Wait for 100 milliseconds
 
def attachment_right_move(angle, speed = 400, timeout=None): # Creates a function named attachment_right_move for the right motor
    if timeout != None: # Check if a timeout limit is provided
        timeout_watch = StopWatch() # Create a stopwatch object for the timeout
        timeout_watch.resume() # Start the stopwatch
        attachment_right.run_angle(speed, angle * left_gear_ratio, wait=False) # Start moving right attachment in the background
        while abs(attachment_right.angle()-(angle * right_gear_ratio)) > 1: # Loop until target angle is reached
            if timeout_watch.time() >= timeout: break # Break if timeout occurs
    else: # If no timeout is specified
        attachment_right.run_angle(speed, angle * left_gear_ratio) # Runs attachment_right in degrees and waits for completion

def attachment_left_move(angle, speed = 400, timeout = None): # Creates a function named attachment_left_move for the left motor
    if timeout != None: # Check if a timeout limit is provided
        timeout_watch = StopWatch() # Create a stopwatch object for the timeout
        timeout_watch.resume() # Start the stopwatch
        attachment_left.run_angle(speed, angle * left_gear_ratio, wait=False) # Start moving left attachment in the background
        while abs(attachment_left.angle()-(angle * left_gear_ratio)) > 1: # Loop until target angle is reached
            if timeout != None and timeout_watch.time() >= timeout: break # Break if timeout occurs
    else: # If no timeout is specified
        attachment_left.run_angle(speed, angle * left_gear_ratio) # Runs attachment_left in degrees and waits for completion
        
def attachment_right_background(angle, speed = 400): # Creates a function named attachment_right_background for non-blocking movement
    attachment_right.run_angle(speed, angle * right_gear_ratio, wait=False) # Runs attachment_right in degrees and does not wait
 
def attachment_left_background(angle, speed = 400): # Creates a function named attachment_left_background for non-blocking movement
    attachment_left.run_angle(speed, angle * left_gear_ratio, wait=False) # Runs attachment_left in degrees and does not wait
 
