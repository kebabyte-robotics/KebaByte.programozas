def drive_straight(distance, min_speed=40, acceleration=40, correction=0.01, max_speed = 700, deceleration=80, timeout = None): #creates a function named drive_straight, defines parameters to be used in the function; distance, deceleration, and acceleration are given in mm, default values only work on average
    if timeout != None:
        timeout_watch = StopWatch()
        timeout_watch.resume()
    global heading #allows the function to use the heading variable inside the function
    left_motor.reset_angle(0) #sets the left angle to 0
    right_motor.reset_angle(0) #sets the right angle to 0
    distance = distance / 0.489 #converts distance given in mm to motor degrees, dividing wheel circumference by 360
    acceleration /= 0.489 #converts acceleration given in mm to motor degrees, dividing wheel circumference by 360
    deceleration /= 0.489 #converts deceleration given in mm to motor degrees, dividing wheel circumference by 360
    while True: #starts a loop that runs until stopped
        if timeout != None and timeout_watch.time() >= timeout: break            
        distance_done = (left_motor.angle()+right_motor.angle()) / 2 #adds left and right angles and divides by 2, resulting in the average distance covered (distance_done)
        distance_left = distance - distance_done #subtracts distance_done from distance to get distance_left
        multiplier = distance_left/abs(distance_left) #divides distance_left by its absolute value, if distance_left is positive it's 1, if negative it's -1 (e.g., 10/10=1, -10/10=-1)
        distance_done = abs(distance_done) #the absolute value of distance_done should be distance_done, needed to be positive as the multiplier already stored the direction
        distance_left = abs(distance_left) #the absolute value of distance_left should be distance_left, needed to be positive as the multiplier already stored the direction
        if distance_left < 3: #if distance_left is less than 3 motor degrees
            break #then stop, i.e., exit the while loop
        if distance_left < deceleration : #if distance_left is less than deceleration (if already in the deceleration phase)
            ratio = distance_left / deceleration #then the deceleration ratio is distance_left/deceleration, this is the ratio which is between 0-1
            current_speed = max(ratio * max_speed, min_speed) * multiplier #current_speed is the maximum of min_speed (so it doesn't go slower) or ratio*max_speed, multiplied by the multiplier (1 or -1) for direction
        elif distance_done < acceleration: #if not the previous, and distance_done is less than acceleration (it's in the acceleration phase)
            ratio = distance_done / acceleration #the ratio equals distance_done / acceleration, this number can be 0-1
            current_speed = max(ratio * max_speed, min_speed) * multiplier ##current_speed is the maximum of min_speed (so it doesn't go slower) or ratio*max_speed, multiplied by the multiplier (1 or -1) for direction
        else: #if none of the above (neither accelerating nor decelerating)
            current_speed = max_speed * multiplier #current_speed equals max_speed * multiplier, which can be 1 or -1, turning the number positive/negative
        heading_error = (heading - hub.imu.heading()) * correction #heading_error equals heading (where it should go) minus the actual current degree multiplied by correction (needed to correct smoothly, not in one big jump)
        correction_amount = current_speed * heading_error * multiplier #correction_amount equals current_speed * heading_error * multiplier (1,-1), this will be the amount to correct by
        left_motor.run (current_speed - correction_amount) #left runs at current_speed - correction_amount (minus because if it veers right, positive error, it subtracts, i.e., slows down; if left, negative error, -- is +, i.e., speeds up)
        right_motor.run(current_speed + correction_amount) #right runs at current_speed + correction_amount (plus because if it veers right, positive error, it stays +, i.e., speeds up; if left, negative error, it stays -, i.e., slows down)
    left_motor.hold() #left stops (holds its position right there)
    right_motor.hold()#right stops (holds its position right there)
 
def turn(target_angle, max_speed=360, deceleration=80, min_speed=50, timeout = None): #creates a function named turn, defines parameters to be used; target_angle (in degrees), max_speed, deceleration (in degrees), min_speed, default parameters only work on average
    if timeout != None:
        timeout_watch = StopWatch()
        timeout_watch.resume()
    base_angle = hub.imu.heading() #base_angle equals the gyro value, needed to correct based on previous errors
    global heading #allows the function to use the heading variable inside the function
    target_heading = heading + target_angle #target_heading = heading (where it should have been) + target_angle (heading is used to fix previous errors)
    heading = target_heading #heading equals target_heading
    target_heading -= base_angle #subtract base_angle (the error) from target_heading
    while True: #loop runs until exit
        if timeout != None and timeout_watch.time() >= timeout: break
        angle_done = hub.imu.heading() - base_angle #angle_done equals current gyro - base_angle
        angle_left = target_heading - angle_done #angle_left equals target_heading - angle_done
        multiplier = angle_left/abs(angle_left) #divides angle_left by its absolute value, if angle_left is positive it's 1, if negative it's -1 (e.g., 10/10=1, -10/10=-1)
        angle_left = abs(angle_left) #the absolute value of angle_left should be angle_left, needed to be positive as the multiplier already stored direction
        if angle_left <= 0.5: #if angle_left is less than or equal to 0.5
            break #then stop, i.e., exit the while loop      
        if angle_left < deceleration : #if angle_left is less than deceleration (i.e., in the deceleration phase)
            ratio = angle_left / deceleration #then the deceleration ratio is angle_left/deceleration, this ratio is between 0-1
            current_speed = max(ratio * max_speed, min_speed) * multiplier #current_speed is the maximum of min_speed (so it doesn't go slower) or ratio*max_speed, multiplied by the multiplier (1 or -1)
        else: #if not the previous, i.e., not decelerating
            current_speed = max_speed * multiplier #then current_speed equals max_speed * multiplier (1 or -1)
        left_motor.run(-current_speed) #left runs at -current_speed (minus because if turning right, positive error becomes minus, goes backward; if left, negative error, -- is +, goes forward)
        right_motor.run(current_speed) #right runs at current_speed (plus because if turning right, positive stays positive, goes forward; if left, negative stays negative, goes backward)
    left_motor.hold() #left stops (holds its position)
    right_motor.hold() #right stops (holds its position)
    wait(100)
 
def attachment_right_move(angle, speed = 400, timeout=None): #creates a function named attachment_right_move, with angle and speed as parameters, referring to the right attachment motor
    if timeout != None:
        timeout_watch = StopWatch()
        timeout_watch.resume()
        attachment_right.run_angle(speed, angle * left_gear_ratio, wait=False) #runs attachment_right in degrees, speed and angle given as parameters multiplied by left_gear_ratio
        while abs(attachment_right.angle()-(angle * right_gear_ratio)) > 1:
            if timeout_watch.time() >= timeout: break
    else:
        attachment_right.run_angle(speed, angle * left_gear_ratio) #runs attachment_right in degrees, speed and angle given as parameters multiplied by left_gear_ratio

def attachment_left_move(angle, speed = 400, timeout = None): #creates a function named attachment_left_move, with angle and speed as parameters, referring to the left attachment motor
    if timeout != None:
        timeout_watch = StopWatch()
        timeout_watch.resume()
        attachment_left.run_angle(speed, angle * left_gear_ratio, wait=False) #runs attachment_left in degrees, speed and angle given as parameters multiplied by left_gear_ratio
        while abs(attachment_left.angle()-(angle * left_gear_ratio)) > 1:
            if timeout != None and timeout_watch.time() >= timeout: break
    else:
        attachment_left.run_angle(speed, angle * left_gear_ratio) #runs attachment_left in degrees, speed and angle given as parameters multiplied by left_gear_ratio
        
def attachment_right_background(angle, speed = 400): #creates a function named attachment_right_background, with angle and speed as parameters, works during movement
    attachment_right.run_angle(speed, angle * right_gear_ratio, wait=False) #runs attachment_right in degrees, speed and angle given multiplied by right_gear_ratio, doesn't wait (runs in background)
 
def attachment_left_background(angle, speed = 400): #creates a function named attachment_left_background, with angle and speed as parameters, works during movement
    attachment_left.run_angle(speed, angle * left_gear_ratio, wait=False) #runs attachment_left in degrees, speed and angle given multiplied by left_gear_ratio, doesn't wait (runs in background)
 
